[Unit]
Description=Keynest — aplicar actualización on-demand (flag en el dir de datos)

[Path]
# Dos layouts: capistrano (/var/lib/keynest, StateDirectory del install.sh) y
# plano (/opt/keynest/data, deploy manual tipo CT 226). El apply in-app escribe
# el flag en el dir escribible correspondiente; cualquiera de los dos lo
# dispara. systemd vigila por inotify (fuera del sandbox del servicio).
PathExists=/var/lib/keynest/.update-requested
PathExists=/opt/keynest/data/.update-requested
Unit=keynest-update.service

[Install]
WantedBy=multi-user.target
