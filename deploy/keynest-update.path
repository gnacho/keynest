[Unit]
Description=Keynest — aplicar actualización o rollback on-demand (flag en el dir de datos)

[Path]
# Dos layouts: capistrano (/var/lib/keynest, StateDirectory del install.sh) y
# plano (/opt/keynest/data, deploy manual tipo CT 226). El apply y el rollback
# in-app escriben el flag en el dir escribible correspondiente; cualquiera de
# las cuatro rutas lo dispara. systemd vigila por inotify (fuera del sandbox
# del servicio).
PathExists=/var/lib/keynest/.update-requested
PathExists=/opt/keynest/data/.update-requested
PathExists=/var/lib/keynest/.rollback-requested
PathExists=/opt/keynest/data/.rollback-requested
Unit=keynest-update.service

[Install]
WantedBy=multi-user.target
