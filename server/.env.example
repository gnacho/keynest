# --- Servidor ---
PORT=8081
DATA_DIR=/opt/keynest/data
STATIC_DIR=/opt/keynest/public

# --- Auth: bootstrap del primer admin (se vuelca a users en el primer arranque) ---
AUTH_USER=admin
AUTH_PASS=cambia-esto-min-6
SESSION_SECRET=change-me-session-secret-32-bytes
ENC_KEY=change-me-encryption-key-32-bytes

# --- Sync iCal (ms, mínimo 60000) ---
SYNC_INTERVAL_MS=900000

# --- Proxy inverso: true si la app está detrás de NPM/Caddy (IP real y cookies Secure) ---
TRUST_PROXY=false
